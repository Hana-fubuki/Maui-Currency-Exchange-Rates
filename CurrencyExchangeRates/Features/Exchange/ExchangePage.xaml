<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CurrencyExchangeRates.Features.Exchange.Controls"
             xmlns:models="clr-namespace:CurrencyExchangeRates.Models"
             xmlns:viewModels="clr-namespace:CurrencyExchangeRates.Features.Exchange"
             x:Class="CurrencyExchangeRates.Features.Exchange.ExchangePage"
             x:DataType="viewModels:ExchangeViewModel"
             Background="{AppThemeBinding Light=#F8F9FA, Dark=#202124}"
             Loaded="OnLoaded">

    <Grid
        Padding="24"
        ColumnDefinitions="*"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="18">

        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <Label
                FontAttributes="Bold"
                FontFamily="OpenSansSemibold"
                FontSize="28"
                Text="Currency Exchange Rates"
                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
            <Label
                FontSize="14"
                Text="Powered by Frankfurter API"
                TextColor="{StaticResource Primary}"
                TextDecorations="Underline">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFrankfurterTapped" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>

        <Grid Grid.Row="1">
            <Grid
                ColumnDefinitions="3.2*,5.8*"
                ColumnSpacing="20">

                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="16">
                    <Border
                        Background="{AppThemeBinding Light=#F8F9FA, Dark=#202124}"
                        Padding="20"
                        Stroke="{AppThemeBinding Light=#E0E3E7, Dark=#3C4043}"
                        StrokeShape="RoundRectangle 24">
                        <VerticalStackLayout Spacing="8">
                            <Label
                                FontSize="16"
                                Text="{Binding DisplayBaseSummaryText}"
                                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                            <Label
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemibold"
                                FontSize="38"
                                LineHeight="1.15"
                                Margin="0,0,0,4"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding DisplayRateText}" />
                                        <Span Text=" " />
                                        <Span
                                            FontAttributes="None"
                                            FontFamily="OpenSansRegular"
                                            FontSize="20"
                                            Text="{Binding DisplayQuoteNameText}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label
                                FontSize="14"
                                Text="{Binding DisplayDateText}"
                                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="14"
                                IsVisible="{Binding HasDisplayTrend}"
                                Text="{Binding DisplayTrendText}"
                                TextColor="{Binding DisplayTrendColor}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Background="{AppThemeBinding Light=#F8F9FA, Dark=#202124}"
                        Padding="4"
                        Stroke="{AppThemeBinding Light=#F8F9FA, Dark=#202124}"
                        StrokeShape="RoundRectangle 24">
                        <VerticalStackLayout Spacing="12">
                            <Border
                                x:Name="BaseInputContainer"
                                Padding="14,6"
                                Background="{AppThemeBinding Light=#F8F9FA, Dark=#202124}"
                                Stroke="{AppThemeBinding Light=#5F6368, Dark=#5F6368}"
                                StrokeShape="RoundRectangle 8">
                                <Grid ColumnDefinitions="1.55*,Auto,1.1*" ColumnSpacing="10" HeightRequest="52">
                                    <Entry
                                        x:Name="BaseAmountEntry"
                                        Background="Transparent"
                                        FontAttributes="Bold"
                                        FontSize="22"
                                        Focused="OnInputAreaFocused"
                                        HorizontalTextAlignment="Start"
                                        Keyboard="Numeric"
                                        Margin="0"
                                        Text="{Binding BaseAmountText, Mode=TwoWay}"
                                        Unfocused="OnInputAreaUnfocused"
                                        VerticalTextAlignment="Center" />
                                    <BoxView
                                        Grid.Column="1"
                                        Background="{AppThemeBinding Light=#DADCE0, Dark=#5F6368}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Fill"
                                        WidthRequest="1" />
                                    <Picker
                                        x:Name="BaseCurrencyPicker"
                                        Grid.Column="2"
                                        Background="Transparent"
                                        FontSize="15"
                                        Focused="OnInputAreaFocused"
                                        HorizontalOptions="End"
                                        ItemDisplayBinding="{Binding Name}"
                                        ItemsSource="{Binding Currencies}"
                                        Margin="0"
                                        SelectedItem="{Binding SelectedBaseCurrency}"
                                        Unfocused="OnInputAreaUnfocused"
                                        WidthRequest="185" />
                                </Grid>
                            </Border>

                            <Border
                                x:Name="QuoteInputContainer"
                                Padding="14,6"
                                Background="{AppThemeBinding Light=#F8F9FA, Dark=#202124}"
                                Stroke="{AppThemeBinding Light=#5F6368, Dark=#5F6368}"
                                StrokeShape="RoundRectangle 8">
                                <Grid ColumnDefinitions="1.55*,Auto,1.1*" ColumnSpacing="10" HeightRequest="52">
                                    <Entry
                                        x:Name="QuoteAmountEntry"
                                        Background="Transparent"
                                        FontAttributes="Bold"
                                        FontSize="22"
                                        Focused="OnInputAreaFocused"
                                        HorizontalTextAlignment="Start"
                                        Keyboard="Numeric"
                                        Margin="0"
                                        Text="{Binding QuoteAmountText, Mode=TwoWay}"
                                        Unfocused="OnInputAreaUnfocused"
                                        VerticalTextAlignment="Center" />
                                    <BoxView
                                        Grid.Column="1"
                                        Background="{AppThemeBinding Light=#DADCE0, Dark=#5F6368}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Fill"
                                        WidthRequest="1" />
                                    <Picker
                                        x:Name="QuoteCurrencyPicker"
                                        Grid.Column="2"
                                        Background="Transparent"
                                        FontSize="15"
                                        Focused="OnInputAreaFocused"
                                        HorizontalOptions="End"
                                        ItemDisplayBinding="{Binding Name}"
                                        ItemsSource="{Binding Currencies}"
                                        Margin="0"
                                        SelectedItem="{Binding SelectedQuoteCurrency}"
                                        Unfocused="OnInputAreaUnfocused"
                                        WidthRequest="185" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Border
                    Grid.Column="1"
                    Background="{AppThemeBinding Light=#F8F9FA, Dark=#202124}"
                    Padding="16"
                    Stroke="{AppThemeBinding Light=#E0E3E7, Dark=#3C4043}"
                    StrokeShape="RoundRectangle 24">
                    <Grid RowDefinitions="Auto,*" RowSpacing="14">
                        <HorizontalStackLayout
                            BindableLayout.ItemsSource="{Binding TimeRanges}"
                            Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:TimeRangeOption">
                                    <Button
                                        Padding="16,10"
                                        Background="{AppThemeBinding Light=#F0F1F5, Dark=#242635}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectTimeRangeCommand}"
                                        CommandParameter="{Binding .}"
                                        CornerRadius="18"
                                        FontAttributes="Bold"
                                        Text="{Binding Label}"
                                        TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}">
                                        <Button.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsSelected}"
                                                TargetType="Button"
                                                Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="TextColor" Value="{StaticResource White}" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>

                        <Grid Grid.Row="1">
                            <controls:ExchangeRateChart
                                FillBottomColor="{Binding ChartFillBottomColor}"
                                FillTopColor="{Binding ChartFillTopColor}"
                                LineColor="{Binding ChartLineColor}"
                                Points="{Binding HistoricalPoints}"
                                SelectedRangeEnd="{Binding SelectedRangeEnd, Mode=TwoWay}"
                                SelectedRangeStart="{Binding SelectedRangeStart, Mode=TwoWay}"
                                SelectedPoint="{Binding HighlightedPoint, Mode=TwoWay}"
                                VerticalOptions="Fill" />

                            <Label
                                FontSize="14"
                                HorizontalOptions="Center"
                                IsVisible="{Binding IsChartEmpty}"
                                Text="No chart data available for the selected pair."
                                TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border
                Background="{AppThemeBinding Light=#EAF1FBCC, Dark=#1F2937CC}"
                IsVisible="{Binding IsBusy}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 24">
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    Spacing="12"
                    VerticalOptions="Center">
                    <ActivityIndicator
                        Color="{StaticResource Primary}"
                        HeightRequest="40"
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        WidthRequest="40" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        HorizontalTextAlignment="Center"
                        Text="Updating exchange data..."
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                    <Label
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        Text="Refreshing the latest rate and chart."
                        TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Label
            Grid.Row="2"
            FontSize="13"
            IsVisible="{Binding HasError}"
            Text="{Binding ErrorMessage}"
            TextColor="#C62828" />
    </Grid>
</ContentPage>
