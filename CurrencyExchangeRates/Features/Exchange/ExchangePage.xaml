<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CurrencyExchangeRates.Features.Exchange.Controls"
             xmlns:models="clr-namespace:CurrencyExchangeRates.Models"
             xmlns:viewModels="clr-namespace:CurrencyExchangeRates.Features.Exchange"
             x:Class="CurrencyExchangeRates.Features.Exchange.ExchangePage"
             x:DataType="viewModels:ExchangeViewModel"
             Background="{AppThemeBinding Light={StaticResource WhiteBrush}, Dark={StaticResource Gray950Brush}}"
             Loaded="OnLoaded">

    <Grid
        Padding="24"
        ColumnDefinitions="*"
        RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
        RowSpacing="18">

        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <Label
                FontAttributes="Bold"
                FontFamily="OpenSansSemibold"
                FontSize="28"
                Text="Currency Exchange Rates"
                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
            <Label
                FontSize="14"
                Text="Track live FX quotes and scrub through historical ranges powered by Frankfurter."
                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
        </VerticalStackLayout>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,Auto,*"
            ColumnSpacing="12">

            <VerticalStackLayout Grid.Column="0" Spacing="6">
                <Label
                    FontAttributes="Bold"
                    FontSize="12"
                    Text="From"
                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                <Picker
                    Title="Base currency"
                    ItemDisplayBinding="{Binding DisplayName}"
                    ItemsSource="{Binding Currencies}"
                    SelectedItem="{Binding SelectedBaseCurrency}" />
            </VerticalStackLayout>

            <Button
                Grid.Column="1"
                Padding="18,12"
                Background="{AppThemeBinding Light={StaticResource SecondaryBrush}, Dark={StaticResource Gray900Brush}}"
                Command="{Binding SwapCurrenciesCommand}"
                CornerRadius="20"
                HorizontalOptions="Center"
                Text="Swap"
                VerticalOptions="End" />

            <VerticalStackLayout Grid.Column="2" Spacing="6">
                <Label
                    FontAttributes="Bold"
                    FontSize="12"
                    Text="To"
                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                <Picker
                    Title="Quote currency"
                    ItemDisplayBinding="{Binding DisplayName}"
                    ItemsSource="{Binding Currencies}"
                    SelectedItem="{Binding SelectedQuoteCurrency}" />
            </VerticalStackLayout>
        </Grid>

        <Border
            Grid.Row="2"
            Background="{AppThemeBinding Light=#F8F8FF, Dark=#1E1E2A}"
            Padding="20"
            Stroke="{AppThemeBinding Light=#E4E2F5, Dark=#303244}"
            StrokeShape="RoundRectangle 24">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto">
                <VerticalStackLayout Grid.RowSpan="3" Spacing="8">
                    <Label
                        FontAttributes="Bold"
                        FontFamily="OpenSansSemibold"
                        FontSize="36"
                        Text="{Binding DisplayRateText}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                    <Label
                        FontSize="16"
                        Text="{Binding DisplayPairText}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                    <Label
                        FontSize="14"
                        Text="{Binding DisplayDateText}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                </VerticalStackLayout>

                <ActivityIndicator
                    Grid.Column="1"
                    Color="{StaticResource Primary}"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    VerticalOptions="Start" />

                <Label
                    Grid.Row="1"
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="14"
                    HorizontalTextAlignment="End"
                    Text="{Binding ChangeSummaryText}"
                    TextColor="{Binding ChangeSummaryColor}"
                    VerticalTextAlignment="Center" />

                <Label
                    Grid.Row="2"
                    Grid.Column="1"
                    FontSize="12"
                    HorizontalTextAlignment="End"
                    Text="{Binding DataSourceText}"
                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                    VerticalTextAlignment="End" />
            </Grid>
        </Border>

        <HorizontalStackLayout
            Grid.Row="3"
            BindableLayout.ItemsSource="{Binding TimeRanges}"
            Spacing="10">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="models:TimeRangeOption">
                    <Button
                        Padding="16,10"
                        Background="{AppThemeBinding Light=#F0F1F5, Dark=#242635}"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectTimeRangeCommand}"
                        CommandParameter="{Binding .}"
                        CornerRadius="18"
                        FontAttributes="Bold"
                        Text="{Binding Label}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}">
                        <Button.Triggers>
                            <DataTrigger
                                Binding="{Binding IsSelected}"
                                TargetType="Button"
                                Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </HorizontalStackLayout>

        <Border
            Grid.Row="4"
            Background="{AppThemeBinding Light={StaticResource WhiteBrush}, Dark=#161824}"
            Padding="16"
            Stroke="{AppThemeBinding Light=#E8E8EF, Dark=#2B2D3D}"
            StrokeShape="RoundRectangle 24">
            <Grid>
                <controls:ExchangeRateChart
                    HeightRequest="340"
                    Points="{Binding HistoricalPoints}"
                    SelectedPoint="{Binding HighlightedPoint, Mode=TwoWay}" />

                <Label
                    FontSize="14"
                    HorizontalOptions="Center"
                    IsVisible="{Binding IsChartEmpty}"
                    Text="No chart data available for the selected pair."
                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <Label
            Grid.Row="5"
            FontSize="13"
            IsVisible="{Binding HasError}"
            Text="{Binding ErrorMessage}"
            TextColor="#C62828" />
    </Grid>
</ContentPage>
